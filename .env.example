# Local PostgreSQL connection for DEBEST Academy
DATABASE_URL=postgresql://debest:change-this-password@localhost:5432/debest_academy
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
PORT=5501

# Optional: SpaceXAI (xAI) key for the public website assistant.
# Without it, the chat widget still answers common FAQs from school information on this site.
# Create a key at https://console.x.ai and keep it server-side only.
XAI_API_KEY=
# Optional model override (default grok-4.5)
# XAI_MODEL=grok-4.5

# Optional: Business Pulse tracker (fees, expenses and application activity).
# Leave blank to switch the connection off; the Fees & payments page still works.
# URL = your published tracker address + /api/ingest
# KEY = the "Website API key" shown on the tracker's Connect page
BUSINESS_PULSE_URL=
BUSINESS_PULSE_KEY=

# Strongly recommended: replace the built-in demo staff passwords.
# SECRETARY_PASS=
# MANAGER_PASS=
# HEADMASTER_PASS=
# SUPERADMIN_USER=
# SUPERADMIN_PASS=
