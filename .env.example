# Local PostgreSQL connection for DEBEST Academy
DATABASE_URL=postgresql://debest:change-this-password@localhost:5432/debest_academy
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
PORT=5501

# Required admin credentials for local and production deployments.
# Use unique, strong values and never commit real secrets to GitHub.
SECRETARY_PASS=replace-with-a-strong-secret
MANAGER_PASS=replace-with-a-strong-secret
HEADMASTER_PASS=replace-with-a-strong-secret
SUPERADMIN_USER=SuperAdmin
SUPERADMIN_PASS=replace-with-a-strong-secret
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-secret
COMMA_PASS=replace-with-a-strong-secret

# Optional: SpaceXAI (xAI) key for the public website assistant.
# Without it, the chat widget still answers common FAQs from school information on this site.
# Create a key at https://console.x.ai and keep it server-side only.
XAI_API_KEY=
# Optional model override (default grok-4.5)
# XAI_MODEL=grok-4.5
