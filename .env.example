# Copy to .env and customize for production / school LAN

# Bind address: 0.0.0.0 allows other PCs on the school network to connect
HOST=0.0.0.0
PORT=5500

# Required for production — use a long random string
JWT_SECRET=CHANGE_ME_IN_PROD

# Optional: only these client IPs may call admin APIs (comma-separated)
# Example: ADMIN_IP_ALLOWLIST=192.168.1.10,192.168.1.11,192.168.1.12
ADMIN_IP_ALLOWLIST=

# Seed passwords used only when creating missing admin accounts on first start
SECRETARY_PASS=Secretary123
MANAGER_PASS=Manager123
HEADMASTER_PASS=Headmaster123
ADMIN_USER=admin
ADMIN_PASS=Admin123
COMMA_PASS=comma4711
