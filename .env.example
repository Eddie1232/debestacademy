# Local PostgreSQL connection for DEBEST Academy
DATABASE_URL=postgresql://debest:change-this-password@localhost:5432/debest_academy
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
PORT=5501

# Finance staff account; change this before production use
BURSAR_USER=Bursar
BURSAR_PASS=replace-with-a-strong-password

# Optional: OpenAI API key for server-side DataPulse AI school insights.
# Keep this key on the server only; without it, rule-based insights are used.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Optional: SpaceXAI (xAI) key for the public website assistant.
# Without it, the chat widget still answers common FAQs from school information on this site.
# Create a key at https://console.x.ai and keep it server-side only.
XAI_API_KEY=
# Optional model override (default grok-4.5)
# XAI_MODEL=grok-4.5
