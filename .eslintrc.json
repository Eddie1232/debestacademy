{
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "globals": {
    "DebestAdmin": "readonly"
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off"
  }
}
